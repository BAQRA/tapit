{
  "name": "tapit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test && npm run build",
    "types": "wrangler types --include-env=false",
    "db:migrate:local": "wrangler d1 migrations apply tapit --local",
    "db:migrate:remote": "wrangler d1 migrations apply tapit --remote"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "~4.1",
    "wrangler": "^4.157.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.0",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "description": "TapIT: NFC Google-review cards with redirect tracking and dashboards (Cloudflare Workers + D1).",
  "engines": {
    "node": ">=20"
  }
}
